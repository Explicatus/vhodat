generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  phone        String?
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  announcements Announcement[]
  issues       Issue[]
  votes        Vote[]
}

// Етажна собственост (сграда / вход)
model Building {
  id            String         @id @default(cuid())
  name          String
  address       String
  city          String
  bulstat       String?
  iban          String?
  inviteCode    String         @unique
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  units         Unit[]
  expenses      Expense[]
  announcements Announcement[]
  polls         Poll[]
  issues        Issue[]
}

// role: MANAGER (домоуправител / управител) | RESIDENT (собственик / обитател)
model Membership {
  id         String   @id @default(cuid())
  userId     String
  buildingId String
  role       String   @default("RESIDENT")
  unitId     String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit       Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@unique([userId, buildingId])
}

// Самостоятелен обект (апартамент, магазин, гараж, ателие)
model Unit {
  id          String       @id @default(cuid())
  buildingId  String
  number      String
  kind        String       @default("APARTMENT")
  entrance    String?
  floor       Int?
  area        Float?
  idealParts  Float        @default(0) // идеални части в %
  ownerName   String?
  ownerEmail  String?
  residents   Int          @default(1)
  monthlyFee  Float        @default(0) // месечна такса в евро
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  charges     Charge[]
  payments    Payment[]
  memberships Membership[]
  votes       Vote[]

  @@unique([buildingId, number])
}

// Задължение (начисление) към обект
model Charge {
  id          String   @id @default(cuid())
  unitId      String
  period      String   // "2026-11"
  type        String   @default("MONTHLY") // MONTHLY | REPAIR_FUND | ONE_TIME
  description String
  amount      Float
  dueDate     DateTime
  createdAt   DateTime @default(now())
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  unitId    String
  amount    Float
  paidAt    DateTime @default(now())
  method    String   @default("CASH") // CASH | BANK | CARD
  note      String?
  createdAt DateTime @default(now())
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  buildingId  String
  date        DateTime
  category    String   // ELECTRICITY | CLEANING | ELEVATOR | REPAIR | WATER | OTHER
  amount      Float
  description String
  vendor      String?
  createdAt   DateTime @default(now())
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model Announcement {
  id         String   @id @default(cuid())
  buildingId String
  authorId   String
  title      String
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// Гласуване (решение на Общо събрание / писмено гласуване)
model Poll {
  id          String       @id @default(cuid())
  buildingId  String
  question    String
  description String?
  closesAt    DateTime
  createdAt   DateTime     @default(now())
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  options     PollOption[]
  votes       Vote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  order  Int    @default(0)
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  Vote[]
}

// Един глас на обект; тежестта е по идеални части
model Vote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  unitId    String
  userId    String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, unitId])
}

// Сигнал за повреда / проблем
model Issue {
  id          String   @id @default(cuid())
  buildingId  String
  authorId    String
  title       String
  description String
  location    String?
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
