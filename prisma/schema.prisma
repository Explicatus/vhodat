generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  phone        String?
  passwordHash String
  emailVerifiedAt DateTime?
  termsAcceptedAt DateTime?
  deletedAt       DateTime?
  notifyEmail  Boolean      @default(true)
  notifySms    Boolean      @default(false)
  notifyViber  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  notifications Notification[]
  memberships  Membership[]
  announcements Announcement[]
  issues       Issue[]
  votes        Vote[]
  onlinePayments OnlinePayment[]
  authTokens   AuthToken[]
  sessions     Session[]
}

// Етажна собственост (сграда / вход)
model Building {
  id            String         @id @default(cuid())
  name          String
  address       String
  city          String
  bulstat       String?
  iban          String?
  inviteCode    String         @unique
  // Stripe Connect сметка на етажната собственост (парите отиват директно при нея)
  stripeAccountId      String?  @unique
  stripeChargesEnabled Boolean  @default(false)
  // Абонамент за платформата: FREE (до 10 обекта) | PRO (на обект / месец)
  plan                 String    @default("FREE")
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  // Автоматизация: ден от месеца (1–28) или null = изключено
  autoChargeDay        Int?
  autoRepairFundCents  Int       @default(0)
  autoRemindDay        Int?
  lastAutoChargePeriod String?
  lastAutoRemindPeriod String?
  createdAt     DateTime       @default(now())
  onlinePayments OnlinePayment[]
  memberships   Membership[]
  units         Unit[]
  expenses      Expense[]
  announcements Announcement[]
  polls         Poll[]
  issues        Issue[]
}

// role: MANAGER (домоуправител / управител) | RESIDENT (собственик / обитател)
model Membership {
  id         String   @id @default(cuid())
  userId     String
  buildingId String
  role       String   @default("RESIDENT")
  // заявка за обект, която чака одобрение от управителя
  requestedUnitId String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  units      MemberUnit[]

  @@unique([userId, buildingId])
}

// Самостоятелен обект (апартамент, магазин, гараж, ателие)
model Unit {
  id          String       @id @default(cuid())
  buildingId  String
  number      String
  kind        String       @default("APARTMENT")
  entrance    String?
  floor       Int?
  area        Float?
  idealParts  Float        @default(0) // идеални части в %
  ownerName   String?
  ownerEmail  String?
  residents   Int          @default(1)
  monthlyFeeCents Int      @default(0) // месечна такса в евроцентове
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  charges     Charge[]
  payments    Payment[]
  memberUnits MemberUnit[]
  votes       Vote[]
  onlinePayments OnlinePayment[]

  @@unique([buildingId, number])
}

// Задължение (начисление) към обект
model Charge {
  id          String   @id @default(cuid())
  unitId      String
  period      String   // "2026-11"
  type        String   @default("MONTHLY") // MONTHLY | REPAIR_FUND | ONE_TIME
  description String
  amountCents Int      // в евроцентове
  dueDate     DateTime
  createdAt   DateTime @default(now())
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(cuid())
  unitId    String
  amountCents Int    // в евроцентове
  paidAt    DateTime @default(now())
  method    String   @default("CASH") // CASH | BANK | CARD
  note      String?
  createdAt DateTime @default(now())
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  online    OnlinePayment?
}

// Опит за онлайн плащане с карта (Stripe Checkout или тестов режим)
model OnlinePayment {
  id          String    @id @default(cuid())
  buildingId  String
  unitId      String
  userId      String
  amountCents Int       // в евроцентове
  platformFeeCents Int  @default(0)
  status      String    @default("PENDING") // PENDING | PAID | CANCELED
  provider    String    // stripe | mock
  providerRef String?   @unique // Stripe Checkout Session id
  paymentId   String?   @unique
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

model Expense {
  id          String   @id @default(cuid())
  buildingId  String
  date        DateTime
  category    String   // ELECTRICITY | CLEANING | ELEVATOR | REPAIR | WATER | OTHER
  amountCents Int      // в евроцентове
  description String
  vendor      String?
  createdAt   DateTime @default(now())
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
}

model Announcement {
  id         String   @id @default(cuid())
  buildingId String
  authorId   String
  title      String
  body       String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// Гласуване (решение на Общо събрание / писмено гласуване)
model Poll {
  id          String       @id @default(cuid())
  buildingId  String
  question    String
  description String?
  closesAt    DateTime
  createdAt   DateTime     @default(now())
  building    Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  options     PollOption[]
  votes       Vote[]
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  order  Int    @default(0)
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  Vote[]
}

// Един глас на обект; тежестта е по идеални части
model Vote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  unitId    String
  userId    String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, unitId])
}

// Сигнал за повреда / проблем
model Issue {
  id          String   @id @default(cuid())
  buildingId  String
  authorId    String
  title       String
  description String
  location    String?
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// Известие в приложението (дублира се по имейл / SMS / Viber според настройките)
model Notification {
  id         String    @id @default(cuid())
  userId     String
  buildingId String?
  title      String
  body       String
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Ред от импортирано банково извлечение
model BankTxn {
  id              String   @id @default(cuid())
  buildingId      String
  hash            String
  date            DateTime
  amountCents     Int
  reason          String
  counterparty    String?
  suggestedUnitId String?
  confidence      String?  // HIGH | MEDIUM
  status          String   @default("NEW") // NEW | IMPORTED | IGNORED
  paymentId       String?
  createdAt       DateTime @default(now())

  @@unique([buildingId, hash])
  @@index([buildingId, status])
}

// Еднократен токен: възстановяване на парола (RESET) или потвърждаване на имейл (VERIFY).
// Пазим само SHA-256 хеш — изтекла база данни не дава работещи линкове.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Връзка потребител ↔ обект. Един собственик може да има няколко обекта (апартамент + гараж).
model MemberUnit {
  id           String     @id @default(cuid())
  membershipId String
  unitId       String
  createdAt    DateTime   @default(now())
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  unit         Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([membershipId, unitId])
}

// Неизтриваема история на промените (кой, какво, кога) — за прозрачност и при спорове.
model AuditLog {
  id          String   @id @default(cuid())
  buildingId  String
  userId      String?
  userName    String   // снимка на името към момента (остава и ако профилът бъде изтрит)
  action      String   // напр. payment.create, charge.reverse, member.role
  summary     String
  amountCents Int?
  createdAt   DateTime @default(now())

  @@index([buildingId, createdAt])
}

// Вход от едно устройство. Може да се прекрати поотделно („Изход“ на конкретно устройство).
model Session {
  id         String    @id @default(cuid())
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Опити за вход / регистрация / възстановяване — за ограничаване на атаки с налучкване.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
