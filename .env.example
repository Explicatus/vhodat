# ── Локална разработка: копирайте като .env — работи без външни услуги ──
# База (от `docker compose up -d db`)
DATABASE_URL="postgresql://vhodat:vhodat@localhost:5432/vhodat"
# Произволен дълъг низ; в продукция: openssl rand -base64 32
SESSION_SECRET="local-dev-secret-change-me-0123456789abcdef"
APP_URL="http://localhost:3000"
CRON_SECRET="local-dev-cron-secret"

# Плащания: "1" = симулирано плащане с карта и абонамент, без Stripe. НИКОГА в продукция.
PAYMENTS_MOCK="1"
PLATFORM_FEE_PERCENT="1"

# ── Външни услуги: оставете празни локално (имейлите/SMS се показват в конзолата) ──
# Stripe (продукция): sk_live_… / whsec_… / price_… и PAYMENTS_MOCK="0"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
# Имейл (SMTP), напр. Brevo/Postmark/SES
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Входът <no-reply@vhodat.bg>"
# SMS и Viber през Infobip
INFOBIP_BASE_URL=""
INFOBIP_API_KEY=""
SMS_SENDER="Vhodat"
VIBER_SENDER=""
